PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_FILE=./database/portfolio.sqlite

# Optional: set this if you want to view inquiries through GET /api/inquiries.
# Then request with header: x-admin-token: your-secret-token
ADMIN_TOKEN=change-this-before-production

# Telegram Visitor & Contact Alert Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

